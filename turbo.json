{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**"],
      "outputs": ["dist/**"],
      "env": ["VITE_MOCK"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
